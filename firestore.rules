rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role
        : 'STUDENT';
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'ADMIN';
    }

    function isFaculty() {
      return isSignedIn() && (getRole() == 'FACULTY' || isAdmin());
    }

    function isStudent() {
      return isSignedIn() && getRole() == 'STUDENT';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 1. Users Collection
    match /users/{userId} {
      // Privileged attributes may only be assigned by an administrator
      function privilegedFieldsUnchanged() {
        return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['role', 'status', 'email', 'facultyId', 'studentId']) == false;
      }

      allow read: if isSignedIn();
      // Self-provisioning is limited to the caller's own STUDENT document
      allow create: if isAdmin() ||
        (isOwner(userId) && request.resource.data.role == 'STUDENT');
      // Users may edit their own profile fields (name, phone); Admins have full control
      allow update: if isAdmin() || (isOwner(userId) && privilegedFieldsUnchanged());
      allow delete: if isAdmin();
    }

    // 2. Students Directory
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Faculty Directory
    match /faculty/{facultyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Courses Catalog
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Course Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      // Faculty and Admin can mark and update attendance; Students are blocked from modifying
      allow write: if isFaculty() || isAdmin();
    }

    // 7. Academic Marks & Grades
    match /marks/{markId} {
      allow read: if isSignedIn();
      // Faculty and Admin can enter and update marks; Students cannot write
      allow write: if isFaculty() || isAdmin();
    }

    // 8. Examination Schedules
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isFaculty() || isAdmin();
    }

    // 9. System Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // 10. System Metadata
    match /system_metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
