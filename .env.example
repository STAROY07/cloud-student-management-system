# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration (PostgreSQL / Google Cloud SQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_sms
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_sms
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Google Cloud SQL (Production)
# INSTANCE_CONNECTION_NAME=project-id:region:instance-name
# DB_SOCKET_PATH=/cloudsql/project-id:region:instance-name

# Authentication & Security
JWT_SECRET=super-secure-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# CORS & Client Origins
CORS_ORIGIN=http://localhost:5173

# Google Cloud Project Configuration
GCP_PROJECT_ID=
GCP_REGION=us-central1
